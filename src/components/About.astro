---
import { Image } from 'astro:assets';
import { site } from '../site.config';
import portrait from '../assets/portrait.jpg';

const [lead, ...rest] = site.about;
---

<section id="about" class="section">
  <div class="container about">
    <Image
      src={portrait}
      alt={`${site.name}, arms folded, in a black jacket over a beige shirt`}
      widths={[360, 540, 720]}
      sizes="(min-width: 760px) 400px, 100vw"
      class="portrait"
      loading="lazy"
    />
    <div class="text">
      <h2 class="section-title">About</h2>
      <p class="lead">{lead}</p>
      {rest.map((paragraph) => <p class="muted">{paragraph}</p>)}
    </div>
  </div>
</section>

<style>
  .about {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
    gap: clamp(32px, 5vw, 72px);
    align-items: center;
  }

  .portrait {
    display: block;
    width: 100%;
    max-width: 400px;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 50% 22%;
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }

  .text {
    display: flex;
    flex-direction: column;
    gap: 20px;
    max-width: 36em;
  }

  .lead {
    font-size: 19px;
  }
</style>
