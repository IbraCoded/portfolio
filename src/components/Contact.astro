---
import { site } from '../site.config';
---

<section id="contact" class="section">
  <div class="container contact">
    <h2>{site.contactHeadline}</h2>
    <div class="email-row">
      <a href={`mailto:${site.email}`} class="email">{site.email}</a>
      <button type="button" class="btn btn--small" data-copy-email={site.email}>Copy email</button>
      <span class="visually-hidden" role="status" data-copy-status></span>
    </div>
    <div class="link-row socials">
      <a href={site.github}>GitHub</a>
      <a href={site.linkedin}>LinkedIn</a>
      <a href={site.cv} download>CV (PDF)</a>
    </div>
  </div>
</section>

<footer class="container footer">
  <p>© {new Date().getFullYear()} {site.name}</p>
</footer>

<style>
  .section > .contact {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 28px;
    padding-block: clamp(72px, 9vw, 136px);
  }

  h2 {
    max-width: 14em;
    font-size: clamp(36px, 5.4vw, 76px);
    line-height: 1.02;
    letter-spacing: -0.03em;
  }

  .email-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px;
  }

  .email {
    font-size: clamp(18px, 2vw, 26px);
    font-weight: 500;
    overflow-wrap: anywhere;
  }

  .socials a {
    color: var(--muted);
  }

  .socials a:hover {
    color: var(--accent);
  }

  .footer {
    padding-block: 24px 32px;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 14px;
  }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy-email]').forEach((button) => {
    // Screen readers don't reliably announce a button's label changing, so say it in a status region too.
    const status = button.parentElement?.querySelector('[data-copy-status]');
    let timer: number | undefined;
    button.addEventListener('click', async () => {
      const email = button.dataset.copyEmail ?? '';
      try {
        await navigator.clipboard.writeText(email);
        button.textContent = 'Copied';
      } catch {
        button.textContent = 'Copy failed';
      }
      if (status) status.textContent = button.textContent === 'Copied' ? 'Email address copied' : 'Copy failed';
      window.clearTimeout(timer);
      timer = window.setTimeout(() => {
        button.textContent = 'Copy email';
        if (status) status.textContent = '';
      }, 1600);
    });
  });
</script>
