---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import { site } from '../site.config';
---

<Base title={`Page not found | ${site.name}`}>
  <Header home={false} />
  <main id="main" class="container notfound">
    <h1>This page doesn't exist.</h1>
    <p class="muted">The link may be out of date, or the address may have a typo.</p>
    <a href="/" class="btn btn--primary">Go to the homepage</a>
  </main>
</Base>

<style>
  .notfound {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 24px;
    padding-block: clamp(80px, 14vw, 180px);
  }

  h1 {
    font-size: clamp(36px, 5vw, 64px);
    letter-spacing: -0.03em;
    line-height: 1.05;
  }
</style>
