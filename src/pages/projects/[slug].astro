---
// A case study page for every project whose Markdown file has body text.
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import ProjectLinks from '../../components/ProjectLinks.astro';
import { getProjects, hasCaseStudy, type Project } from '../../lib/projects';
import { site } from '../../site.config';

export async function getStaticPaths() {
  const { all } = await getProjects();
  return all.filter(hasCaseStudy).map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

interface Props {
  project: Project;
}

const { project } = Astro.props;
const { Content } = await render(project);
const { title, summary, description, context, year, stack } = project.data;
---

<Base title={`${title} | ${site.name}`} description={summary}>
  <Header home={false} />
  <main id="main" class="container case">
    <a href="/#work" class="back">All work</a>
    <header class="case-header">
      <h1>{title}</h1>
      <p class="meta">{[context, year].filter(Boolean).join(', ')}</p>
      <p class="description">{description ?? summary}</p>
      {stack.length > 0 && <p class="stack">{stack.join(', ')}</p>}
      <ProjectLinks project={project} showCaseStudy={false} />
    </header>
    <article class="prose">
      <Content />
    </article>
  </main>
</Base>

<style>
  .case {
    padding-block: clamp(32px, 5vw, 64px) clamp(72px, 9vw, 128px);
  }

  .back {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    color: var(--muted);
    font-size: 15px;
  }

  .case-header {
    display: flex;
    flex-direction: column;
    gap: 16px;
    max-width: 44em;
    padding-block: 24px 40px;
    border-bottom: 1px solid var(--line);
  }

  h1 {
    font-size: clamp(36px, 5vw, 68px);
    line-height: 1.02;
    letter-spacing: -0.03em;
  }

  .meta,
  .stack {
    color: var(--muted);
    font-size: 15px;
  }

  .description {
    color: var(--muted);
    font-size: 19px;
  }

  .prose {
    max-width: 42em;
    padding-top: 40px;
    font-size: 18px;
    line-height: 1.7;
  }

  .prose :global(h2) {
    margin: 2.2em 0 0.6em;
    font-size: 28px;
    letter-spacing: -0.02em;
  }

  .prose :global(h3) {
    margin: 1.8em 0 0.5em;
    font-size: 21px;
  }

  .prose :global(p),
  .prose :global(ul),
  .prose :global(ol) {
    margin: 0 0 1.1em;
  }

  .prose :global(li + li) {
    margin-top: 0.4em;
  }

  .prose :global(code) {
    font-family: var(--font-mono);
    font-size: 0.88em;
    padding: 0.1em 0.35em;
    background: var(--raised);
    border-radius: 4px;
  }

  .prose :global(pre) {
    margin: 0 0 1.4em;
    padding: 18px 20px;
    overflow-x: auto;
    background: var(--bg-deep) !important;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    font-size: 14px;
    line-height: 1.7;
  }

  .prose :global(pre code) {
    padding: 0;
    background: none;
  }

  .prose :global(img) {
    border-radius: var(--radius);
    border: 1px solid var(--line);
  }

  .prose :global(table) {
    display: block;
    max-width: 100%;
    overflow-x: auto;
    margin: 0 0 1.4em;
    border-collapse: collapse;
    font-size: 16px;
    font-variant-numeric: tabular-nums;
  }

  .prose :global(th),
  .prose :global(td) {
    padding: 10px 12px;
    border-bottom: 1px solid var(--line);
    text-align: left;
  }

  .prose :global(blockquote) {
    margin: 0 0 1.2em;
    padding-left: 20px;
    border-left: 2px solid var(--accent);
    color: var(--muted);
  }
</style>
